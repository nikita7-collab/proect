#include <iostream>
using namespace std;

int main() {
int num, count = 0;
double sum = 0;

cout << "Введите число: ";
cin >> num;

while (num != 0) {
count++;
sum += num;
cout << "Введите число: ";
cin >> num;
}

if (count > 0) {
cout << "Среднее арифметическое: " << sum / count << endl;
} else {
cout << "Чисел не введено" << endl;
}

return 0;
}
