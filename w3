#include <iostream>
using namespace std;

int main() {
int num, count = 0, sum = 0;

cout << "Введите число: ";
cin >> num;

while (num != 0) {
count++;
sum += num;
cout << "Введите число: ";
cin >> num;
}

cout << "Количество чисел: " << count << endl;
cout << "Сумма: " << sum << endl;

return 0;
}
