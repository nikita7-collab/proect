#include <iostream>
#include <vector>

using namespace std;

void displayBoard(const vector<vector<char>>& board) {
    cout << "\n";
    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 3; ++j) {
            cout << " " << board[i][j];
            if (j < 2) cout << " |";
        }
        cout << "\n";
        if (i < 2) cout << "-----------\n";
    }
    cout << "\n";
}


bool checkWin(const vector<vector<char>>& board, char player) {
    
    for (int i = 0; i < 3; ++i) {
        if ((board[i][0] == player && board[i][1] == player && board[i][2] == player) ||
            (board[0][i] == player && board[1][i] == player && board[2][i] == player)) {
            return true;
        }
    }

    
    if ((board[0][0] == player && board[1][1] == player && board[2][2] == player) ||
        (board[0][2] == player && board[1][1] == player && board[2][0] == player)) {
        return true;
    }

    return false;
}


bool checkDraw(const vector<vector<char>>& board) {
    for (int i = 0; i < 3; ++i) {
        for (int j = 0; j < 3; ++j) {
            if (board[i][j] == ' ') {
                return false; // Есть пустые клетки — игра продолжается
            }
        }
    }
    return true; // Все клетки заполнены — ничья
}

int main() {
    vector<vector<char>> board(3, vector<char>(3, ' ')); // Игровое поле 3x3
    char currentPlayer = 'X'; // Начинают крестики
    int row, col;

    cout << "Добро пожаловать в Крестики-Нолики!\n";

    while (true) {
        displayBoard(board);
        cout << "Игрок " << currentPlayer << ", введите номер строки (1-3) и столбца (1-3): ";
        cin >> row >> col;

        
        if (row < 1 || row > 3 || col < 1 || col > 3) {
            cout << "Некорректный ввод! Введите числа от 1 до 3.\n";
            continue;
        }

       
        row--;
        col--;

        
        if (board[row][col] != ' ') {
            cout << "Эта клетка уже занята! Выберите другую.\n";
            continue;
        }

        
        board[row][col] = currentPlayer;

       
        if (checkWin(board, currentPlayer)) {
            displayBoard(board);
            cout << "Поздравляем! Игрок " << currentPlayer << " победил!\n";
            break;
        }

        
        if (checkDraw(board)) {
            displayBoard(board);
            cout << "Ничья!\n";
            break;
        }

        currentPlayer = (currentPlayer == 'X') ? 'O' : 'X';
    }

    return 0;
}
